# ── 알림 (최소 1개 권장) ──
SLACK_WEBHOOK_URL=

# ── Email (선택) ──
# Gmail로 보낼 경우: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=보내는_지메일주소, SMTP_PASSWORD=구글 '앱 비밀번호'(2단계 인증 필요, 로그인 비번 아님)
# EMAIL_TO는 쉼표로 여러 명 지정 가능. 예: a@x.com, b@y.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# ── 카카오톡 '나에게 보내기' (선택) ──
# 카카오 개발자 앱의 REST API 키 + talk_message 동의로 발급한 refresh token
# (내 카카오톡 '나와의 채팅'으로 다이제스트 + 링크 발송)
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=
# 카카오 메시지의 '전체 보기' 링크가 가리킬 아카이브 베이스 URL (선택)
# 예: https://github.com/LumenSemantics/on-demand-rag/blob/main/reports
REPORT_BASE_URL=

# ── 요약·분류 LLM (선택) ──
# 미설정 시: 요약은 초록 발췌, 분류는 키워드 규칙으로 폴백 (완전 무료)
# 주의: 값 뒤에 인라인 주석(# ...)을 달지 말 것 — 주석이 값으로 읽힘.
# provider: openai / anthropic / gemini 중 하나
LLM_PROVIDER=
LLM_API_KEY=
# 예시 모델: gpt-4o-mini / claude-3-5-haiku-latest / gemini-flash-lite-latest
LLM_MODEL=

# ── 기타 ──
DB_PATH=data/seen.db
ARCHIVE_DIR=reports
