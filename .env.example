# ── 알림 (최소 1개 권장) ──
SLACK_WEBHOOK_URL=

# ── Email (선택) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# ── 요약 LLM (선택: 미설정 시 제목·링크만 알림, 완전 무료) ──
LLM_PROVIDER=          # openai | anthropic | gemini
LLM_API_KEY=
LLM_MODEL=             # 예: gpt-4o-mini / claude-3-5-haiku-latest / gemini-2.0-flash

# ── 기타 ──
DB_PATH=data/seen.db
